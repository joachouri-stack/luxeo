# ============================================
# LUXEO COMPOSER API — variables d'environnement
# ============================================

# Port d'écoute (Coolify gère via PORT automatiquement)
PORT=3000

# Clé API fal.ai — OBLIGATOIRE
# Récupérer sur https://fal.ai/dashboard/keys
FAL_KEY=

# Modèle d'édition d'image (défaut : flux-pro/kontext)
# Alternatives :
#   fal-ai/nano-banana/edit
#   fal-ai/gemini-flash-edit
FAL_MODEL=fal-ai/flux-pro/kontext

# Paramètres modèle (basse résolution pour limiter les coûts)
FAL_IMAGE_SIZE=landscape_4_3
FAL_STEPS=28
FAL_GUIDANCE=3.5

# Origines CORS autorisées (séparées par virgule)
ALLOWED_ORIGINS=https://luxeo.pro,https://www.luxeo.pro

# Rate limits par IP
RATE_LIMIT_GENERATE=5   # générations IA par 30 min par IP
RATE_LIMIT_QUOTE=4      # envois de devis par 60 min par IP

# ============================================
# EMAIL — Nodemailer SMTP
# ============================================
# Exemples Hostinger : smtp.hostinger.com / 587 (STARTTLS) ou 465 (SSL)
# Exemples Gmail     : smtp.gmail.com / 587 (utiliser un App Password)
# Exemples OVH       : ssl0.ovh.net / 465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=info@luxeo.pro
SMTP_PASS=
SMTP_FROM="Luxeo Composer" <info@luxeo.pro>

# Adresse qui reçoit les demandes de devis
QUOTE_TO=info@luxeo.pro
QUOTE_SUBJECT=Nouvelle composition Composer — devis Luxeo
