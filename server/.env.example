# ============================================
# LUXEO COMPOSER API — variables d'environnement
# ============================================

# Port d'écoute (Coolify gère via PORT automatiquement)
PORT=3000

# Clé API fal.ai — OBLIGATOIRE
# Récupérer sur https://fal.ai/dashboard/keys
FAL_KEY=

# Modèle d'édition d'image (défaut : flux-pro/kontext)
# Alternatives :
#   fal-ai/nano-banana/edit
#   fal-ai/gemini-flash-edit
FAL_MODEL=fal-ai/flux-pro/kontext

# Paramètres modèle (basse résolution pour limiter les coûts)
FAL_IMAGE_SIZE=landscape_4_3
FAL_STEPS=28
FAL_GUIDANCE=3.5

# Origines CORS autorisées (séparées par virgule)
ALLOWED_ORIGINS=https://luxeo.pro,https://www.luxeo.pro

# Rate limit par IP : nombre de requêtes max par fenêtre de 30 min
RATE_LIMIT_MAX=5
